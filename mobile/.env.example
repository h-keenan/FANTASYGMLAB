# Copy to .env and fill in real values. Never commit .env — it's gitignored.
#
# Expo only exposes env vars prefixed EXPO_PUBLIC_ to app code, and anything
# with that prefix is bundled into the client — so only put values here that
# are safe to ship inside the app binary (same rule as the web app's anon key).

# Same project the web app (FantasyGM Lab / DynastyGM) already uses.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# services/mobile_api_service.py — local dev points at your machine's Streamlit/
# API host; production points at the deployed Render mobile-api service.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# RevenueCat public SDK keys (per platform) — safe to embed, not the secret key.
EXPO_PUBLIC_REVENUECAT_IOS_SDK_KEY=appl_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_ANDROID_SDK_KEY=goog_REPLACE_ME

# AdMob rewarded ad unit IDs (Trade Hub's "watch ad for more ideas" gate).
# Unset defaults to Google's permanent public TEST unit IDs (src/lib/env.ts),
# which always fill with a test creative — fine for TestFlight/dev. Fill
# these in with real unit IDs once an AdMob account/app exists, and update
# the react-native-google-mobile-ads app IDs in app.json to match.
EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=

# Google sign-in (src/lib/useGoogleSignIn.ts). Unset = the Google button
# stays hidden on the login screen. Create an OAuth client of type "iOS" and
# one of type "Web application" in Google Cloud Console (APIs & Services >
# Credentials) for this project, then also enable the Google provider in
# Supabase (Authentication > Providers > Google) with the Web client's
# ID/secret — Supabase verifies the token's audience against that Client ID,
# so it must be the Web one, not the iOS one.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
