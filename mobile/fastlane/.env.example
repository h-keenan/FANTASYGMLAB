# Fastlane environment. Copy to mobile/fastlane/.env and fill in.
# Never commit .env — it's gitignored (see mobile/.gitignore).
#
# Run fastlane with: cd mobile && PATH="/opt/homebrew/opt/ruby@3.4/bin:$PATH" bundle exec fastlane ios beta
# (or `android beta`). Bundler reads fastlane/.env automatically via dotenv.

FGL_BUNDLE_ID=com.fantasygmlab.app

# Apple / App Store Connect API key (App Store Connect -> Users and Access ->
# Integrations -> App Store Connect API). Never the .p8 file's contents, just
# its path. Use an ABSOLUTE path — fastlane resolves relative paths against
# different working directories depending on which action reads them
# (some actions vs. plain Ruby/Spaceship calls), so relative paths here are
# unreliable.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/to/local_secrets/apple/AuthKey_XXXXXXXXXX.p8
APPLE_TEAM_ID=
APPLE_ID=

# match — private repo storing encrypted signing certs/profiles.
MATCH_GIT_URL=https://github.com/yawcompanyx-hue/fantasygmlab-certificates.git
MATCH_PASSWORD=
MATCH_READONLY=true

# Google Play service account JSON (Play Console -> Setup -> API access).
GOOGLE_PLAY_JSON_KEY_PATH=/absolute/path/to/local_secrets/google/play-publisher-key.json

# Confirm after the first `expo prebuild` — see comments in Fastfile.
FGL_IOS_WORKSPACE=
FGL_IOS_SCHEME=

# Gradle needs a real JDK; macOS's stub /usr/bin/java isn't enough.
# brew install openjdk@21 if missing.
JAVA_HOME=/opt/homebrew/opt/openjdk@21

# Android SDK location (installed via Android Studio / cmdline-tools).
ANDROID_HOME=/Users/you/Library/Android/sdk

# Android release signing (upload key — Play App Signing re-signs with the
# real app signing key). Generate once with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore local_secrets/android/upload-keystore.jks \
#     -alias fantasygmlab-upload -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE_PATH=/absolute/path/to/local_secrets/android/upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=fantasygmlab-upload
ANDROID_KEY_PASSWORD=
