default_platform(:ios)

# Both platforms use Expo's "Continuous Native Generation": `ios/` and
# `android/` are never committed (see mobile/.gitignore) — every build
# regenerates them fresh from app.json + package.json via `expo prebuild`.
# That keeps signing config and native project state from drifting apart.

def ensure_native_project(platform)
  dir = platform == :ios ? "../ios" : "../android"
  unless Dir.exist?(dir)
    Dir.chdir("..") { sh("npx expo prebuild --platform #{platform} --clean --non-interactive") }
  end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
  )
end

platform :ios do
  desc "Check whether the App Store Connect app record exists"
  lane :app_status do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: ENV.fetch("ASC_KEY_PATH"),
    )
    app = Spaceship::ConnectAPI::App.find(ENV.fetch("FGL_BUNDLE_ID"))
    if app
      UI.success("App exists: #{app.name} (id=#{app.id})")
    else
      UI.important("No App Store Connect app record for #{ENV.fetch('FGL_BUNDLE_ID')}")
    end
  end

  desc "Create the App ID (Developer Portal) and app record (App Store Connect) — pure API-key auth, no Apple ID/2FA"
  lane :create_app do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    bundle_id = ENV.fetch("FGL_BUNDLE_ID")

    existing_id = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == bundle_id }
    if existing_id
      UI.success("App ID already registered: #{existing_id.identifier}")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "FantasyGM Lab", platform: "IOS", identifier: bundle_id)
      UI.success("Registered App ID: #{bundle_id}")
    end

    existing_app = Spaceship::ConnectAPI::App.find(bundle_id)
    if existing_app
      UI.success("App Store Connect app already exists: #{existing_app.name} (id=#{existing_app.id})")
    else
      app = Spaceship::ConnectAPI::App.create(
        name: "FantasyGM Lab",
        version_string: "1.0",
        sku: "fantasygmlab-app",
        primary_locale: "en-US",
        bundle_id: bundle_id,
        platforms: ["IOS"],
      )
      UI.success("Created App Store Connect app: #{app.name} (id=#{app.id})")
    end
  end

  desc "Sync (or, run by a human, rotate) signing certs/profiles via match. Read-only in CI."
  lane :certs do
    match(type: "appstore", api_key: asc_api_key, readonly: ENV["MATCH_READONLY"] != "false")
  end

  desc "Build and upload a TestFlight build"
  lane :beta do
    ensure_native_project(:ios)
    api_key = asc_api_key
    match(type: "appstore", api_key: api_key, readonly: true)
    # expo prebuild's generated Xcode project defaults to automatic signing,
    # which ignores the match-installed profile and reaches for whatever
    # personal/automatic identity Xcode finds locally. Switch it to manual
    # signing pointed at match's profile before archiving.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/FantasyGMLab.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: ENV.fetch("FGL_BUNDLE_ID"),
      profile_name: ENV.fetch("sigh_#{ENV.fetch('FGL_BUNDLE_ID')}_appstore_profile-name"),
    )
    build_app(
      # Confirmed against a real `expo prebuild` run — Expo names both
      # "FantasyGMLab" (from app.json's `name`, spaces stripped).
      workspace: ENV["FGL_IOS_WORKSPACE"] || "ios/FantasyGMLab.xcworkspace",
      scheme: ENV["FGL_IOS_SCHEME"] || "FantasyGMLab",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end

platform :android do
  desc "Build and upload a Play internal-testing build"
  lane :beta do
    ensure_native_project(:android)
    gradle(project_dir: "android", task: "bundle", build_type: "Release")
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY_PATH"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
