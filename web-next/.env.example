# Same Supabase project the mobile app uses.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A locally running `uvicorn services.mobile_api_service:app --reload --port 8000`
# (run from the repo root). Defaults to this value if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Stripe web billing (plans/checkout/portal) runs on Supabase Edge Functions.
# Rollback only: set to "fastapi" to use the deprecated /v1/billing/* routes.
# NEXT_PUBLIC_BILLING_BACKEND=supabase
