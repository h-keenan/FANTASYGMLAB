# Same Supabase project the Streamlit app and mobile app already use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A locally running `uvicorn services.mobile_api_service:app --reload --port 8000`
# (run from the repo root). Defaults to this value if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# A locally running `streamlit run app.py` (default port 8501). Every page
# this Revision 1 doesn't cover yet deep-links out to Streamlit's own
# `?page=` router — see src/lib/streamlitLink.ts.
NEXT_PUBLIC_STREAMLIT_BASE_URL=http://localhost:8501
