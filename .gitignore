.cursor/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Streamlit / local process logs dumped at repo root (historical + future)
*.log
*.pid
*.tmp
*.temp
*.bak
*.old
*.orig
*.out
*.err
.tmp_*
.tmp_streamlit_*
streamlit_*.log
tmp_*
temp_*

# Generated QA / CI / local capture outputs (recreate on demand)
artifacts/**
!artifacts/.gitkeep
test-results/
playwright-report/
.cache/

# Runtime analytics + feedback (host-local; not source)
data/launch_analytics.jsonl
data/feedback_reports.json
data/feedback_reports.jsonl
feedback_reports.jsonl

# Generated player-cache sidecars (derived from data/players.db)
data/*.public-player-snapshot.json
data/*.public-player-snapshot.pkl
data/*.value-history.json

# Runtime-fetched NFL schedule cache (modules.nfl_schedule) — refetched
# periodically from nflverse, never a committed fixture.
data/nfl_games.csv

# Runtime-fetched nflverse historical_contracts cache + its dataset-as-of
# timestamp (modules.nflverse_contracts) — same posture as nfl_games.csv
# above, never a committed fixture.
data/nflverse_historical_contracts.csv.gz
data/nflverse_historical_contracts_timestamp.json

# Runtime-fetched DynastyProcess player id table (modules.espn_player_crosswalk),
# the ESPN id -> Sleeper id crosswalk for ESPN import. Never a committed fixture.
data/dynastyprocess_playerids.csv
.streamlit/cache/

# Local measurement dumps (scripts default to artifacts/measurements/)
data/*measurement*.json
data/*_measurement.json
data/*benchmark*.json
settings.local.json
