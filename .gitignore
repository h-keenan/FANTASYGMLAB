**/*service_role*
**/*service-role*
**/*secret_key*
**/*webhook_secret*
*.token
*.tokens
*.session
*.sessions
local_sessions/
local_tokens/

# Python environment and cache
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp_*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

