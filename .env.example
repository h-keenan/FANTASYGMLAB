# FantasyDesk — self-hosted environment file.
#
# Copy this to `.env` (same directory as docker-compose.yml) and fill in
# real values. `.env` is already gitignored (see .gitignore's `.env` /
# `.env.*` / `!.env.example` rules) — never commit the filled-in file.
#
# Variable names below are copied verbatim from render.yaml so transferring
# a value out of Render's dashboard (Render service -> Environment tab) into
# this file is mechanical: same key, same value, no renaming/guessing.
# Each section header names the exact Render service the values come from.
#
# docker-compose.yml loads this whole file for every service via
# `env_file: .env`; each service's render.yaml-derived variables are listed
# below grouped by service, but it's one shared file, so a var only one
# service needs is simply unused by the others.

# =============================================================================
# Caddy / domains / TLS
# =============================================================================
# Real Let's Encrypt cert registration contact — Caddy emails this address
# only for certificate-related notices (e.g. expiry problems).
CADDY_ACME_EMAIL=ops@fantasygmlab.com

# Placeholder production hostnames — point real DNS A/CNAME records at this
# server's IP for each of these once the stack is verified working (see
# docs/SELF_HOSTED_MIGRATION.md's DNS cutover section). Matches the one real
# custom domain already live on Render today (app.fantasygmlab.com /
# fantasygmlab.com — see docs/RENDER_DEPLOYMENT.md); the api/webhook
# subdomains are new placeholders since those services are reached via
# Render's own *.onrender.com hosts today and have no custom domain yet.
APP_DOMAIN=app.fantasygmlab.com
MARKETING_DOMAIN=fantasygmlab.com
MARKETING_DOMAIN_WWW=www.fantasygmlab.com
MOBILE_API_DOMAIN=api.fantasygmlab.com
STRIPE_WEBHOOK_DOMAIN=stripe-webhook.fantasygmlab.com
REVENUECAT_WEBHOOK_DOMAIN=revenuecat-webhook.fantasygmlab.com
# NEW, additive, test-subdomain-only preview of the web-next (Next.js)
# frontend — see docker-compose.yml's `web-next` service and
# docs/SELF_HOSTED_MIGRATION.md's "web-next test-subdomain preview"
# section. Deliberately NOT app.fantasygmlab.com/APP_DOMAIN above, which
# keeps routing to the real production Streamlit app untouched. Needs its
# own Cloudflare DNS record (A/CNAME to this box's IP), same as every
# other subdomain here.
WEB_NEXT_DOMAIN=next.fantasygmlab.com

# =============================================================================
# fantasygm-lab (Streamlit web app) — Render service "fantasygm-lab"
# =============================================================================
APP_BASE_URL=https://app.fantasygmlab.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_SECRET_KEY=
# "test" until live-billing review; "live" requires a matching sk_live_ secret.
STRIPE_BILLING_MODE=test
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
DYNASTYGM_BUILD=
# Must remain unset/false for production launch.
DYNASTYGM_SHOW_EXPERIMENTAL=
# Optional crash reporting — fully inert until this is a real Sentry DSN.
SENTRY_DSN=

# =============================================================================
# fantasygm-lab-stripe-webhook — Render service "fantasygm-lab-stripe-webhook"
# (historical Blueprint name; live service may be named
# "fantasygmlab-stripe-webhook" in the Render dashboard — verify association
# per docs/webhook-operational-authority.md before treating values as final)
# =============================================================================
# SUPABASE_URL is shared with the web app's value above.
SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY / STRIPE_BILLING_MODE are shared with the web app's
# values above (must match the same mode — test vs. live — as the web app).
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY / STRIPE_PRICE_ANNUAL are shared with the web app's
# values above.

# =============================================================================
# fantasygm-lab-mobile-api — Render service "fantasygm-lab-mobile-api"
# =============================================================================
# SUPABASE_URL / SUPABASE_ANON_KEY are shared with the web app's values
# above. This service never uses a service-role key (see
# services/mobile_api_service.py — it verifies tokens against Supabase
# GoTrue directly).
# SENTRY_DSN is shared with the web app's value above (optional, separate
# Sentry project recommended but not required).
# Rate limiting has sane built-in defaults (see RATE_LIMIT_* constants in
# services/mobile_api_service.py) — these are optional tuning overrides only.
RATE_LIMIT_ENABLED=
RATE_LIMIT_GENERAL_MAX=
RATE_LIMIT_GENERAL_WINDOW_SECONDS=
RATE_LIMIT_MUTATING_MAX=
RATE_LIMIT_MUTATING_WINDOW_SECONDS=
# REDIS_URL — NEW (not a render.yaml var): backs the rate limiter above and
# the three single-flight caches in modules/trade_hub_engine.py,
# modules/league_rankings.py, modules/playoff_simulator.py (see
# modules/redis_cache.py). On the self-hosted docker-compose.yml stack this
# defaults to redis://redis:6379/0 (the compose `redis` service) if left
# unset, so you typically don't need to set this at all there. On Render
# (or anywhere NOT running docker-compose.yml's redis service) this MUST be
# set to a real reachable Redis instance, or both the rate limiter and the
# three caches silently fail open / run uncached (see modules/redis_cache.py's
# module docstring) — not a crash, but a real loss of the protection/sharing
# this migration adds until a Redis instance is actually provisioned there.
REDIS_URL=
# MOBILE_API_WORKERS — NEW, self-hosted (docker-compose.yml) only; Render's
# render.yaml runs its own separate startCommand untouched by this var.
# Defaults to 4 if unset — see docker-compose.yml's mobile-api comment for
# the box-spec reasoning. Only safe to raise alongside REDIS_URL actually
# pointing at a healthy Redis (see that same comment).
MOBILE_API_WORKERS=

# =============================================================================
# fantasygm-lab-revenuecat-webhook — Render service
# "fantasygm-lab-revenuecat-webhook"
# =============================================================================
# SUPABASE_URL is shared with the web app's value above.
# SUPABASE_SERVICE_ROLE_KEY is shared with the stripe-webhook value above.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# "test" until live-billing review; must match SANDBOX vs PRODUCTION events.
REVENUECAT_BILLING_MODE=test

# Read-only Fantasy AI content export: SHA-256 of a separate random service token.
FGL_CONTENT_TOKEN_SHA256=

# Read-only external API (in-house weekly projections, etc.) for coridian_'s
# external content-posting bot. A single random shared secret (not hashed —
# unlike FGL_CONTENT_TOKEN_SHA256 above, sent as-is in the bot's Authorization:
# Bearer header and compared with secrets.compare_digest). See
# docs/external-api-contract.md. Missing configuration returns 503; a wrong
# key returns 401. This credential cannot access user/league routes.
FANTASYDESK_EXTERNAL_API_KEY=

# =============================================================================
# web-next (Next.js frontend) — NEW, additive test-subdomain preview only.
# Not a Render service (web-next has never been deployed to Render — see
# PR #1095/render.yaml, which added a Render entry for it but is not the
# live deploy path; this self-hosted box is). Values below mirror
# web-next/.env.example's own NEXT_PUBLIC_* names exactly — same variables,
# just filled in here for the box's real `.env` instead of a contributor's
# local `web-next/.env.local`.
#
# IMPORTANT: these four are baked into the client JS bundle at Docker BUILD
# time (Next.js statically inlines `process.env.NEXT_PUBLIC_*` during
# `next build` — see web-next/Dockerfile's header comment and
# docker-compose.yml's `web-next` service build.args), not read at
# container runtime the way every other var in this file is. Changing one
# of these requires `docker compose build web-next` (or a full
# `docker compose build`) to actually take effect — restarting the
# container alone will keep serving the old baked-in value.
# =============================================================================
# Same Supabase project as SUPABASE_URL/SUPABASE_ANON_KEY above — this is
# the browser-facing anon-key pair, safe to expose client-side the same way
# it already is in the Streamlit app and mobile app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The REAL public mobile-api URL (MOBILE_API_DOMAIN above), not an internal
# Docker service name — every web-next page is a client component that
# calls this from the user's own browser (src/lib/api.ts's
# authorizedRequest), never from this container itself, so an internal
# hostname like http://mobile-api:8080 would not be reachable here even if
# used.
NEXT_PUBLIC_API_BASE_URL=https://api.fantasygmlab.com
# Pages web-next doesn't cover yet deep-link out to Streamlit's own
# `?page=` router (APP_DOMAIN above) — same real production Streamlit URL.
NEXT_PUBLIC_STREAMLIT_BASE_URL=https://app.fantasygmlab.com
