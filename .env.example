# FantasyGM Lab — self-hosted environment file.
#
# Copy this to `.env` (same directory as docker-compose.yml) and fill in
# real values. `.env` is already gitignored (see .gitignore's `.env` /
# `.env.*` / `!.env.example` rules) — never commit the filled-in file.
#
# Variable names below are copied verbatim from render.yaml so transferring
# a value out of Render's dashboard (Render service -> Environment tab) into
# this file is mechanical: same key, same value, no renaming/guessing.
# Each section header names the exact Render service the values come from.
#
# docker-compose.yml loads this whole file for every service via
# `env_file: .env`; each service's render.yaml-derived variables are listed
# below grouped by service, but it's one shared file, so a var only one
# service needs is simply unused by the others.

# =============================================================================
# Caddy / domains / TLS
# =============================================================================
# Real Let's Encrypt cert registration contact — Caddy emails this address
# only for certificate-related notices (e.g. expiry problems).
CADDY_ACME_EMAIL=ops@fantasygmlab.com

# Placeholder production hostnames — point real DNS A/CNAME records at this
# server's IP for each of these once the stack is verified working (see
# docs/SELF_HOSTED_MIGRATION.md's DNS cutover section). Matches the one real
# custom domain already live on Render today (app.fantasygmlab.com /
# fantasygmlab.com — see docs/RENDER_DEPLOYMENT.md); the api/webhook
# subdomains are new placeholders since those services are reached via
# Render's own *.onrender.com hosts today and have no custom domain yet.
APP_DOMAIN=app.fantasygmlab.com
MARKETING_DOMAIN=fantasygmlab.com
MARKETING_DOMAIN_WWW=www.fantasygmlab.com
MOBILE_API_DOMAIN=api.fantasygmlab.com
STRIPE_WEBHOOK_DOMAIN=stripe-webhook.fantasygmlab.com
REVENUECAT_WEBHOOK_DOMAIN=revenuecat-webhook.fantasygmlab.com

# =============================================================================
# fantasygm-lab (Streamlit web app) — Render service "fantasygm-lab"
# =============================================================================
APP_BASE_URL=https://app.fantasygmlab.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_SECRET_KEY=
# "test" until live-billing review; "live" requires a matching sk_live_ secret.
STRIPE_BILLING_MODE=test
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
DYNASTYGM_BUILD=
# Must remain unset/false for production launch.
DYNASTYGM_SHOW_EXPERIMENTAL=
# Optional crash reporting — fully inert until this is a real Sentry DSN.
SENTRY_DSN=

# =============================================================================
# fantasygm-lab-stripe-webhook — Render service "fantasygm-lab-stripe-webhook"
# (historical Blueprint name; live service may be named
# "fantasygmlab-stripe-webhook" in the Render dashboard — verify association
# per docs/webhook-operational-authority.md before treating values as final)
# =============================================================================
# SUPABASE_URL is shared with the web app's value above.
SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY / STRIPE_BILLING_MODE are shared with the web app's
# values above (must match the same mode — test vs. live — as the web app).
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY / STRIPE_PRICE_ANNUAL are shared with the web app's
# values above.

# =============================================================================
# fantasygm-lab-mobile-api — Render service "fantasygm-lab-mobile-api"
# =============================================================================
# SUPABASE_URL / SUPABASE_ANON_KEY are shared with the web app's values
# above. This service never uses a service-role key (see
# services/mobile_api_service.py — it verifies tokens against Supabase
# GoTrue directly).
# SENTRY_DSN is shared with the web app's value above (optional, separate
# Sentry project recommended but not required).
# Rate limiting has sane built-in defaults (see RATE_LIMIT_* constants in
# services/mobile_api_service.py) — these are optional tuning overrides only.
RATE_LIMIT_ENABLED=
RATE_LIMIT_GENERAL_MAX=
RATE_LIMIT_GENERAL_WINDOW_SECONDS=
RATE_LIMIT_MUTATING_MAX=
RATE_LIMIT_MUTATING_WINDOW_SECONDS=

# =============================================================================
# fantasygm-lab-revenuecat-webhook — Render service
# "fantasygm-lab-revenuecat-webhook"
# =============================================================================
# SUPABASE_URL is shared with the web app's value above.
# SUPABASE_SERVICE_ROLE_KEY is shared with the stripe-webhook value above.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# "test" until live-billing review; must match SANDBOX vs PRODUCTION events.
REVENUECAT_BILLING_MODE=test
